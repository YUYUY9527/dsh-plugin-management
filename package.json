{
  "name": "dsh-plugin-management",
  "version": "1.0.0",
  "description": "外部插件管理器（DeepSeek Harness / dsh 插件）：查看 profile 里已安装的第三方插件（已装版本、最新版本、是否生效为插件层），并在「设置 → 插件」页一键更新 —— External plugin manager for dsh: inventory + one-click update for a profile's third-party plugin packages.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/scan.js && node --check lib/inventory.js && node --check lib/exec.js"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin-manager",
    "profile",
    "pnpm",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YUYUY9527/dsh-plugin-management.git"
  },
  "bugs": {
    "url": "https://github.com/YUYUY9527/dsh-plugin-management/issues"
  },
  "homepage": "https://github.com/YUYUY9527/dsh-plugin-management#readme",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc <2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
